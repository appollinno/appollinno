ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5-5

# Números autorizados a falar com o agente (só dígitos, com código do país, separados por vírgula).
# Ex.: Moçambique 258841234567. Vazio = ninguém é atendido (seguro por defeito).
ALLOWED_NUMBERS=258841234567

# Responder também em grupos? (só quando mencionado). true/false
ALLOW_GROUPS=false

# Pasta onde fica a sessão do WhatsApp (montar como volume no Docker)
AUTH_DIR=./auth
LOG_LEVEL=info
